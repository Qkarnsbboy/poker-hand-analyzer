# Copy into frontend/.env.local (git ignores it).
# These two values are public by design: the browser needs them to show the login screen.

# Supabase: Project Settings -> Data API -> Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase: Project Settings -> API Keys -> "publishable" key (sb_publishable_...)
#   (older projects call it the "anon public" key)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
