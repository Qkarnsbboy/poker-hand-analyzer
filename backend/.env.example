# Copy the values into backend/.env (git ignores it). Never commit real values.

# Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# Supabase: Project Settings -> Data API (or the "Connect" button) -> Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase: "Connect" button (top of dashboard) -> Connection string -> Session pooler.
# Replace [YOUR-PASSWORD] with the database password you saved.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Monthly Claude spend caps in dollars (optional; these are the defaults)
USER_MONTHLY_CAP_USD=2
TOTAL_MONTHLY_CAP_USD=20
